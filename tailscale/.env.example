# Go through README.md and fill in the values below, then copy this file to .env

# Device auth key from https://login.tailscale.com/admin/settings/keys
# Must be generated with the tag "tag:server" and Reusable enabled.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# OAuth client used only by scripts/push-policy.ps1 to push the ACL policy.
# Scopes: "Policy File -> Read & Write". Optional - you can edit the policy
# by hand in the admin console instead.
OAUTH_CLIENT_ID=REPLACE_ME
OAUTH_CLIENT_SECRET=tskey-client-REPLACE_ME
